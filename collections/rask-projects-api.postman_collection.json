          "request": {
            "name": "Create a project (dubbing job)",
            "description": {
              "content": "Create a localization project from an uploaded video, specifying the destination language and optional source language, speaker count, transcription, and glossary. Processing is asynchronous; poll the project to retrieve output artifacts.",
              "type": "text/plain"
            },
            "url": {
