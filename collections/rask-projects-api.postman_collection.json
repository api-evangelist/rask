            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_id\": \"<uuid>\",\n  \"dst_lang\": \"<string>\",\n  \"name\": \"<string>\",\n  \"src_lang\": \"<string>\",\n  \"num_speakers\": \"<integer>\",\n  \"transcript_id\": \"<uuid>\",\n  \"glossary_id\": \"<uuid>\"\n}",
