{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rask AI Media Transcription API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transcription",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a transcription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.rask.ai/v2/transcriptions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Transcribe uploaded media into editable text segments, or provide an SRT file for higher dubbing accuracy. Returns a transcription identifier used when creating a project."
        }
      ]
    }
  ],
  "bundled": true
}